<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de una acción (Fecha / Hora / Usuario / Acción / Distancia), como en el mockup. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2A2A2A"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvItemFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tvItemHora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tvItemUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tvItemAccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D4A017"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tvItemDistancia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace" />

</LinearLayout>
