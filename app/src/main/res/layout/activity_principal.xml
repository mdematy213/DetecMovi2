<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1C1C1C">

    <!-- Título principal -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SISTEMA IoT"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#D4A017"
        android:textAlignment="center"
        android:layout_marginBottom="4dp" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Control de Acceso"
        android:textSize="16sp"
        android:textColor="#888888"
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <!-- Etiqueta RUT -->
    <TextView
        android:id="@+id/tvLabelRut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RUT"
        android:textSize="13sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="4dp" />

    <!-- Campo RUT -->
    <EditText
        android:id="@+id/etRut"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Ej: 22.212.516-2"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:inputType="text"
        android:padding="10dp"
        android:layout_marginBottom="16dp"
        android:background="#2A2A2A" />

    <!-- Etiqueta Contraseña -->
    <TextView
        android:id="@+id/tvLabelContrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contraseña"
        android:textSize="13sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="4dp" />

    <!-- Campo Contraseña -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Contraseña"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:inputType="textPassword"
        android:padding="10dp"
        android:layout_marginBottom="28dp"
        android:background="#2A2A2A" />

    <!-- Botón Iniciar Sesión -->
    <Button
        android:id="@+id/btnIngresar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Iniciar Sesión"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4E2B0E"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginBottom="12dp" />

    <!-- Botón Crear Cuenta -->
    <Button
        android:id="@+id/btnIrRegistro"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Crear Cuenta"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E2E2E"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
