<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1C">

    <!-- Encabezado -->
    <TextView
        android:id="@+id/tvTituloRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear Cuenta"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textAlignment="center"
        android:background="#4E2B0E"
        android:paddingTop="14dp"
        android:paddingBottom="14dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/tvSubtituloRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completa tus datos para registrar en Firebase"
                android:textSize="14sp"
                android:textColor="#D4A017"
                android:textAlignment="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <!-- Campo RUT -->
            <EditText
                android:id="@+id/etRutReg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="RUT (ej: 22.212.516-2)"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:inputType="text"
                android:maxLength="12"
                android:padding="10dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:background="#2A2A2A" />

            <!-- Fila Nombre + Apellido -->
            <LinearLayout
                android:id="@+id/llNombreApellido"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etNombreReg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Nombre"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:inputType="textPersonName|textCapWords"
                    android:padding="10dp"
                    android:layout_marginRight="6dp"
                    android:background="#2A2A2A" />

                <EditText
                    android:id="@+id/etApellidoReg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Apellido"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:inputType="textPersonName|textCapWords"
                    android:padding="10dp"
                    android:background="#2A2A2A" />

            </LinearLayout>

            <!-- Campo Correo -->
            <EditText
                android:id="@+id/etCorreoReg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Correo Electrónico"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:inputType="textEmailAddress"
                android:padding="10dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:background="#2A2A2A" />

            <!-- Cargo (lista desplegable, como en el mockup) -->
            <Spinner
                android:id="@+id/spCargoReg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:background="#2A2A2A"
                android:popupBackground="#2A2A2A"
                android:spinnerMode="dropdown" />

            <!-- Campo Contraseña -->
            <EditText
                android:id="@+id/etContrasenaReg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Contraseña (mínimo 6 caracteres)"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:inputType="textPassword"
                android:padding="10dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
                android:background="#2A2A2A" />

            <!-- Campo Repetir Contraseña -->
            <EditText
                android:id="@+id/etRepetirContrasenaReg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Repetir Contraseña"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:inputType="textPassword"
                android:padding="10dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="20dp"
                android:background="#2A2A2A" />

            <!-- Fila de botones -->
            <LinearLayout
                android:id="@+id/llBotonesRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp">

                <Button
                    android:id="@+id/btnRegistrar"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:text="Registrar"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2E7D32"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginRight="8dp" />

                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:text="Volver"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#7B0000"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
